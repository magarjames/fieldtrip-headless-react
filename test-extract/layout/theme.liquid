<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Tailwind & Fieldtrip CSS -->
    {{ 'fieldtrip.css' | asset_url | stylesheet_tag }}
    {{ 'northline-custom.css' | asset_url | stylesheet_tag }}
    
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      body { margin: 0; padding: 0; }
    </style>
  </head>

  <body>
    <!-- The Main Header Section with the Glass Cart -->
    {% section 'fieldtrip-header' %}

    <!-- The actual page content (e.g. index.json rendering) -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    
    <!-- The Cart Drawer Snippet -->
    {% render 'glass-cart-drawer' %}
    
    <!-- Initialize Lucide Icons -->
    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
