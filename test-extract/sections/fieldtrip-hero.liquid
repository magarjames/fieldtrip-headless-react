<section class="ft-hero shell grid items-end gap-8 pb-10 pt-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]" style="max-width: 1560px; margin-inline: auto; padding-inline: clamp(1rem,4vw,2.25rem);">
  <div class="min-w-0">
    <h1 class="text-[clamp(2.9rem,7.5vw,10rem)] m-0 leading-[0.9] tracking-[-0.045em] uppercase font-black" style="font-family: 'Archivo Black', Archivo, sans-serif;">
      {{ section.settings.heading | newline_to_br }}
    </h1>
    <p class="ft-hero-description mt-6 max-w-[46ch] text-[1.05rem] m-0 leading-[1.55]" style="color: var(--dim);">
      {{ section.settings.description }}
    </p>
    <div class="ft-hero-actions mt-7 flex flex-wrap gap-2.5">
      <a href="{{ section.settings.primary_link }}" class="btn">
        {{ section.settings.primary_button_text }}
      </a>
      <a href="{{ section.settings.secondary_link }}" class="chip">
        {{ section.settings.secondary_button_text }}
      </a>
    </div>
  </div>
  
  <div class="ft-figure self-end justify-self-center lg:justify-self-end w-full max-w-full">
    <!-- 3D Model Placeholder or Image -->
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Hero Figure" class="w-full h-auto object-contain drop-shadow-2xl">
    {% else %}
      <div class="w-full aspect-[3/4] bg-gray-200 animate-pulse rounded-2xl flex items-center justify-center">
        <p class="text-gray-500 font-mono text-sm text-center px-4">Upload a transparent hero image<br>in the Theme Customizer</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Fieldtrip Hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "DRESS\nLIKE YOU\nHAVE\nSOMEWHERE\nTO BE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "18 pieces built to be layered, not admired one at a time. Wide bottoms, boxy tops, and enough colour to ruin a capsule wardrobe."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "See the fits"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "Every piece"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Transparent PNG)"
    }
  ],
  "presets": [
    {
      "name": "Fieldtrip Hero"
    }
  ]
}
{% endschema %}
