/**
 * The release data behind the page.
 *
 * The reference organises a release as: an edition, a set of categories, and
 * expandable subsections beneath each. Same shape here, with a clothing drop
 * in place of product updates.
 *
 * PLACEHOLDER CONTENT. No prices, no stock counts, no reviews, no press.
 * The brand name lives in BRAND, once.
 */

export const BRAND = "SECOND PRESS";

export type Sub = {
  id: string;
  title: string;
  note: string;
  body: string;
  spec: Record<string, string>;
  img: string;
};

export type Category = {
  id: string;
  name: string;
  count: string;
  blurb: string;
  tint: string;
  subs: Sub[];
};

export type Edition = {
  id: string;
  label: string;
  name: string;
  status: "Open" | "Closed" | "Planned";
  headline: string;
  standfirst: string;
  cats: Category[];
};

const t = {
  moss: "from-[#1d2b24] to-[#131a16]",
  clay: "from-[#2b211f] to-[#181312]",
  steel: "from-[#1b2530] to-[#121820]",
  ochre: "from-[#2a2418] to-[#181510]",
};

function sub(
  id: string,
  title: string,
  note: string,
  body: string,
  spec: Record<string, string>,
  img: string,
): Sub {
  return { id, title, note, body, spec, img };
}

